'''
' Cada rango tiene las siguientes propiedades
'
' - Rank: Numero del 1 al 255 (usuarios no enlistados tienen rank=0)
' - Título:               El título del rango.
' - NivelRequerido:       El mínimo nivel requerido para obtener el rango.
' - PuntosFaccionarios:   La mínima cantidad de puntos faccionarios necesarios.
'
' Es MUY importante enumerar los rangos y no saltearse ninguno.
' Las recompensas se calculan basadas en los rangos.
'
' ======== TEMPLATE =========
'
'<N>Rango=<NivelRequerido>-<PuntosFaccionarios>-<Título>
'
' Ejemplo: 1Rango=25-100-Soldado
'''

[INIT]
NumRangos=7

[ArmadaReal]
1Rango=23-500-Recluta Real
2Rango=26-1500-Soldado Real
3Rango=28-3000-Teniente Imperial
4Rango=30-5000-Capitán del Orden
5Rango=32-8000-Caballero del Alba
6Rango=35-12000-Guardián del Trono
7Rango=40-20000-Campeón de la Luz

[LegionCaos]
1Rango=23-500-Iniciado Oscuro
2Rango=26-1500-Acólito Impío
3Rango=28-3000-Emisario Sombrío
4Rango=30-5000-Esbirro Infernal
5Rango=32-8000-Jinete Umbrío
6Rango=35-12000-Señor Oscuro
7Rango=40-20000-Devorador de Almas
