[NPC21]
Name=Bromdir <Quest del Fenix>
Desc=¡El Fénix ha despertado nuevamente! Renace de sus cenizas cada cierto tiempo, tal como lo ha hecho desde antes de que Morgrim fuera tallada en la roca. Tráeme sus plumas, y yo forjaré para ti recompensas que solo el fuego eterno puede conceder.
NpcType=17
Head=0
Body=881
Heading=3
NpcFaceGrh=36207
Movement=1
ShowName=1
Minimap=0
NumQuest=2
